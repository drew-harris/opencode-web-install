+/** Loads GUI bundles from the web UI's own server. Unlike Desktop, the web has no main process or plugin IPC. */
+export function WebPluginGuiLoader(props: {
+  onChange: (plugins: readonly PluginGui[], reserved: readonly string[]) => void
+}) {
+  const global = useGlobal()
+  const controller = createMemo(() => {
+    const conn = global.servers.list()[0]
+
+    return conn ? global.serverCtx(ServerConnection.key(conn)) : undefined
+  })
+  const cache = new Map<string, Loaded>()
+  const [revision, setRevision] = createSignal(0)
+
+  createEffect(() => {
+    const current = controller()
+
+    if (!current) return
+    onCleanup(current.sdk.event.on("plugin.updated", () => setRevision((value) => value + 1)))
+  })
+
+  const [found] = createResource(
+    () => {
+      const current = controller()
+
+      if (!current || current.sdk.connection.status() !== "connected") return
+      return { current, revision: revision() }
+    },
+    async (input) => {
+      const listed = await input.current.sdk.api.plugin.list().then((result) => result.data)
+      const shipped = listed.filter(shipsPluginGui)
+      const reserved = shipped.flatMap((plugin) => (pluginIdAvailable(plugin.id, builtins) ? [] : [plugin.id]))
+      const plugins = (
+        await Promise.all(
+          shipped
+            .filter((plugin) => !reserved.includes(plugin.id))
+            .map(async (plugin) => {
+              const bundle = await input.current.sdk.api.plugin.gui({ id: plugin.id }).then((result) => result.data)
+              const loaded = await load({ id: plugin.id, ...bundle }, cache)
+
+              return runsOn(loaded.definition, undefined) ? loaded : undefined
+            }),
+        )
+      ).filter((plugin): plugin is Loaded => plugin !== undefined)
+      const ids = new Set(plugins.map((plugin) => plugin.id))
+
+      cache.forEach((_, id) => {
+        if (!ids.has(id)) cache.delete(id)
+      })
+
+      return { plugins, reserved }
+    },
+  )
+
+  createEffect(() => {
+    if (found.state !== "ready" && found.state !== "refreshing") return
+    const latest = found.latest
+    const client = () => controller()?.sdk.api
+
+    props.onChange(
+      latest.plugins.map((plugin) => ({ definition: plugin.definition, options: plugin.options, client })),
+      latest.reserved,
+    )
+  })
+
+  return null
+}
+
 /** Evaluates a plugin's bundle when its revision is new to this window. */
